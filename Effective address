address = 200
R1 = 40

memory = {
    200: 500,
    240: 900
}

# Immediate Addressing
print("Immediate Addressing:")
print("Operand =", 25)

# Direct Addressing
print("\nDirect Addressing:")
print("Effective Address =", address)
print("Operand =", memory[address])

# Indirect Addressing
print("\nIndirect Addressing:")
EA = memory[address]
print("Effective Address =", EA)
print("Operand =", memory[EA] if EA in memory else "Not available")

# Indexed Addressing
print("\nIndexed Addressing:")
EA = address + R1
print("Effective Address =", EA)
print("Operand =", memory[EA])
